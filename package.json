{
  "name": "vaj-be",
  "version": "1.0.0",
  "description": "vintage archive jungle - backend project",
  "main": "index.js",
  "scripts": {
    "dev": "nodemon",
    "file": "tsc -p tsconfig.json && node -r tsconfig-paths/register -r ts-node/register",
    "postgres": "tsc -p tsconfig.json && node -r tsconfig-paths/register -r ts-node/register ./dist/be/scripts/database/postgres.js",
    "database-setup": "tsc -p tsconfig.json && node -r tsconfig-paths/register -r ts-node/register ./dist/be/scripts/database/database-setup.js",
    "database-backup": "tsc -p tsconfig.json && node -r tsconfig-paths/register -r ts-node/register ./dist/be/scripts/database/database-backup.js",
    "database-restore": "tsc -p tsconfig.json && node -r tsconfig-paths/register -r ts-node/register ./dist/be/scripts/database/database-restore.js",
    "database-migrate": "tsc -p tsconfig.json && node -r tsconfig-paths/register -r ts-node/register ./dist/be/scripts/database/database-migrate.js",
    "redis": "tsc -p tsconfig.json && node -r tsconfig-paths/register -r ts-node/register ./dist/be/scripts/redis/redis.js",
    "test": "vitest",
    "format": "prettier . --write",
    "lint": "eslint . --fix"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "class-transformer": "^0.5.1",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "graphql-yoga": "^5.17.1",
    "nodemailer": "^9.0.0",
    "pg": "^8.16.3",
    "redis": "^5.11.0",
    "reflect-metadata": "^0.2.2",
    "tsconfig-paths": "^4.2.0",
    "winston": "^3.18.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.15",
    "@types/nodemailer": "^6.4.17",
    "@types/pg": "^8.15.4",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.9.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.0.16"
  }
}
